# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# Razorpay (for booking payments)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# CRM Webhook (optional)
CRM_WEBHOOK_URL=https://your-crm.com/api/webhook

# OpenAI (for AI Creative Studio)
OPENAI_API_KEY=sk-your-openai-key

# Site URL
NEXT_PUBLIC_SITE_URL=https://zebracatindia.com

# Google Search Console verification token (optional)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
